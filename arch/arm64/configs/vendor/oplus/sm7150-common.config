# Camera
CONFIG_REGULATOR_PM8008=y

# Charger
# CONFIG_QPNP_QG is not set
# CONFIG_SMB1355_SLAVE_CHARGER is not set

# Crypto
CONFIG_CRYPTO_DEV_QCOM_ICE=y
CONFIG_CRYPTO_LZ4=y

# Filesystems
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=y

# Fingerprint
CONFIG_OPPO_FINGERPRINT=y
CONFIG_OPPO_FINGERPRINT_QCOM=y

# Haptics
CONFIG_TOUCHSCREEN_OPLUS=y
# CONFIG_TOUCHSCREEN_ST is not set
# CONFIG_TOUCHSCREEN_HIMAX_CHIPSET is not set
# CONFIG_TOUCHSCREEN_HIMAX_I2C is not set
# CONFIG_TOUCHSCREEN_HIMAX_INCELL is not set
# CONFIG_TOUCHSCREEN_HIMAX_IC_HX83112 is not set
# CONFIG_TOUCHSCREEN_HIMAX_DEBUG is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE_EXTRA_SYSFS is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_TEST_REPORTING is not set

# Oplus
CONFIG_MACH_OPLUS=y
CONFIG_MACH_OPLUS_SM7150=y
CONFIG_OPLUS_DEVICE_INFO=y
CONFIG_OPLUS_FEATURE_RECORD_MDMRST=y
CONFIG_OPLUS_FEATURE_OPROJECT=y
CONFIG_OPLUS_FEATURE_PROJECTINFO=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_RAM_ANNOTATION_APPEND=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# Ramdisk
CONFIG_RD_LZ4=y
